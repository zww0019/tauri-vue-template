{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Tauri",
      "program": "${env:HOME}/.cargo/bin/cargo",
      "args": [
        "run",
        "--manifest-path=./src-tauri/Cargo.toml",
        "--no-default-features"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ui:dev",
      "env": {
        "PATH": "${env:HOME}/.cargo/bin:${env:HOME}/.nvm/versions/node/v22.21.1/bin:${env:PATH}"
      },
      "stopOnEntry": false,
      "sourceLanguages": ["rust"],
      "initCommands": [
        // 告诉LLDB在单步执行时，跳过指定路径的代码
        "settings set target.process.thread.step-avoid-regexp ^(__|std|core|alloc|proc_macro|\\[.*)"
    ]
    }
  ]
}
